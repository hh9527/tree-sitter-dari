// 近 14 个完整自然日（Asia/Shanghai）：最近 7 天 vs 此前 7 天，租户告警变化与设备资源对比
data ctx := context();
data days := time_windows(ctx,{unit:"day",count:14,mode:"complete"});

// ---------- 逐日告警（按级别），14 个固定查询 ----------
data d1 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[0].start.epochMillis,end:days[0].end.epochMillis}],limit:100});
data d2 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[1].start.epochMillis,end:days[1].end.epochMillis}],limit:100});
data d3 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[2].start.epochMillis,end:days[2].end.epochMillis}],limit:100});
data d4 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[3].start.epochMillis,end:days[3].end.epochMillis}],limit:100});
data d5 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[4].start.epochMillis,end:days[4].end.epochMillis}],limit:100});
data d6 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[5].start.epochMillis,end:days[5].end.epochMillis}],limit:100});
data d7 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[6].start.epochMillis,end:days[6].end.epochMillis}],limit:100});
data d8 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[7].start.epochMillis,end:days[7].end.epochMillis}],limit:100});
data d9 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[8].start.epochMillis,end:days[8].end.epochMillis}],limit:100});
data d10 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[9].start.epochMillis,end:days[9].end.epochMillis}],limit:100});
data d11 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[10].start.epochMillis,end:days[10].end.epochMillis}],limit:100});
data d12 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[11].start.epochMillis,end:days[11].end.epochMillis}],limit:100});
data d13 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[12].start.epochMillis,end:days[12].end.epochMillis}],limit:100});
data d14 := query({op:"Graph",root:"a",nodes:[{id:"a",entity:"current_alarm"}],edges:[],select:[{node:"a",dimension:"alarm_severity"}],measures:[{node:"a",measure:"alarm_count"}],time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[13].start.epochMillis,end:days[13].end.epochMillis}],limit:100});

data s1 := select({from:{a:d1},fields:(r)=>({day:days[0].label,week:"前一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s2 := select({from:{a:d2},fields:(r)=>({day:days[1].label,week:"前一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s3 := select({from:{a:d3},fields:(r)=>({day:days[2].label,week:"前一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s4 := select({from:{a:d4},fields:(r)=>({day:days[3].label,week:"前一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s5 := select({from:{a:d5},fields:(r)=>({day:days[4].label,week:"前一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s6 := select({from:{a:d6},fields:(r)=>({day:days[5].label,week:"前一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s7 := select({from:{a:d7},fields:(r)=>({day:days[6].label,week:"前一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s8 := select({from:{a:d8},fields:(r)=>({day:days[7].label,week:"最近一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s9 := select({from:{a:d9},fields:(r)=>({day:days[8].label,week:"最近一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s10 := select({from:{a:d10},fields:(r)=>({day:days[9].label,week:"最近一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s11 := select({from:{a:d11},fields:(r)=>({day:days[10].label,week:"最近一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s12 := select({from:{a:d12},fields:(r)=>({day:days[11].label,week:"最近一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s13 := select({from:{a:d13},fields:(r)=>({day:days[12].label,week:"最近一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data s14 := select({from:{a:d14},fields:(r)=>({day:days[13].label,week:"最近一周",severity:r.a.a_alarm_severity ?? "unknown",n:r.a.a_alarm_count})});
data daily := union_all([s1,s2,s3,s4,s5,s6,s7,s8,s9,s10,s11,s12,s13,s14]);

data dailyTotal := select({
  from:{d:daily},group_by:(r)=>({day:r.d.day,week:r.d.week}),
  fields:(g,rows)=>({day:g.day,week:g.week,n:sum(rows.d.n) ?? 0}),
  order_by:(o)=>[asc(o.day)]
});

data weekTotals := select({
  from:{d:daily},group_by:(r)=>({week:r.d.week}),
  fields:(g,rows)=>({week:g.week,n:sum(rows.d.n) ?? 0})
});
data priorWeekTotal := select_one({from:{w:weekTotals},where:(r)=>r.w.week == "前一周",fields:(r)=>({n:r.w.n})});
data recentWeekTotal := select_one({from:{w:weekTotals},where:(r)=>r.w.week == "最近一周",fields:(r)=>({n:r.w.n})});

// ---------- 按租户两周告警指标 ----------
data tenPriorQ := query({op:"Graph",root:"a",
  nodes:[{id:"a",entity:"current_alarm"},{id:"t",entity:"tenant"}],
  edges:[{relation:"alarm_belongs_to_tenant",from:"a",to:"t"}],
  select:[{node:"t",dimension:"tenant_name"}],
  measures:[{node:"a",measure:"alarm_count"},{node:"a",measure:"critical_alarm_count"},{node:"a",measure:"major_alarm_count"},{node:"a",measure:"alarm_open_count"}],
  time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[0].start.epochMillis,end:days[6].end.epochMillis}],
  limit:500});
data tenRecentQ := query({op:"Graph",root:"a",
  nodes:[{id:"a",entity:"current_alarm"},{id:"t",entity:"tenant"}],
  edges:[{relation:"alarm_belongs_to_tenant",from:"a",to:"t"}],
  select:[{node:"t",dimension:"tenant_name"}],
  measures:[{node:"a",measure:"alarm_count"},{node:"a",measure:"critical_alarm_count"},{node:"a",measure:"major_alarm_count"},{node:"a",measure:"alarm_open_count"}],
  time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[7].start.epochMillis,end:days[13].end.epochMillis}],
  limit:500});

data priorTen := select({from:{x:tenPriorQ},
  fields:(r)=>({tenant:r.x.t_tenant_name,total:r.x.a_alarm_count,crit:r.x.a_critical_alarm_count,major:r.x.a_major_alarm_count,open:r.x.a_alarm_open_count})});
data recentTen := select({from:{x:tenRecentQ},
  fields:(r)=>({tenant:r.x.t_tenant_name,total:r.x.a_alarm_count,crit:r.x.a_critical_alarm_count,major:r.x.a_major_alarm_count,open:r.x.a_alarm_open_count})});

data cand := select({
  from:{q:recentTen},
  joins:[{kind:"left",source:{p:priorTen},on:(r)=>r.q.tenant == r.p.tenant}],
  fields:(r)=>({
    tenant:r.q.tenant,
    priorTotal:r.p?.total ?? 0,
    priorCrit:r.p?.crit ?? 0,
    priorMajor:r.p?.major ?? 0,
    priorOpen:r.p?.open ?? 0,
    recentTotal:r.q.total,
    recentCrit:r.q.crit,
    recentMajor:r.q.major,
    recentOpen:r.q.open,
    growth:r.q.total - (r.p?.total ?? 0)
  }),
  order_by:(o)=>[desc(o.growth),asc(o.tenant)]
});

data top5 := select({
  from:{c:cand},
  where:(r)=>(r.c.priorTotal > 0) && (r.c.growth > 0),
  fields:(r)=>({tenant:r.c.tenant,growth:r.c.growth,
    priorTotal:r.c.priorTotal,priorCrit:r.c.priorCrit,priorMajor:r.c.priorMajor,priorOpen:r.c.priorOpen,
    recentTotal:r.c.recentTotal,recentCrit:r.c.recentCrit,recentMajor:r.c.recentMajor,recentOpen:r.c.recentOpen}),
  order_by:(o)=>[desc(o.growth),asc(o.tenant)],limit:5
});
data zeroBase := select({
  from:{c:cand},where:(r)=>(r.c.priorTotal == 0) && (r.c.recentTotal > 0),
  fields:(r)=>({tenant:r.c.tenant,recentTotal:r.c.recentTotal}),
  order_by:(o)=>[desc(o.recentTotal),asc(o.tenant)]
});
data zeroBaseCount := select_one({from:{z:zeroBase},group_by:(r)=>({}),fields:(g,rows)=>({n:count(rows)})});
data alarmTenantCount := select_one({from:{q:recentTen},group_by:(r)=>({}),fields:(g,rows)=>({n:count(rows)})});
data growthTop := select_one({from:{t:top5},fields:(r)=>({tenant:r.t.tenant,growth:r.t.growth,
  priorTotal:r.t.priorTotal,recentTotal:r.t.recentTotal,recentOpen:r.t.recentOpen}),
  order_by:(o)=>[desc(o.growth),asc(o.tenant)],limit:1});

// 增幅对比图数据
data growthPrior := select({from:{t:top5},fields:(r)=>({tenant:r.t.tenant,week:"前一周",weekKey:0,n:r.t.priorTotal}),order_by:(o)=>[asc(o.weekKey)]});
data growthRecent := select({from:{t:top5},fields:(r)=>({tenant:r.t.tenant,week:"最近一周",weekKey:1,n:r.t.recentTotal}),order_by:(o)=>[asc(o.weekKey)]});
data growthLong := union_all([growthPrior,growthRecent]);

// 未清除占比（最近一周）
data openRatio := select({from:{t:top5},
  fields:(r)=>({tenant:r.t.tenant,ratio:round((r.t.recentOpen * 100.0) / r.t.recentTotal,2)}),
  order_by:(o)=>[desc(o.ratio),asc(o.tenant)]});

// ---------- 5 个租户：前后两周设备阈值 ----------
data kpiPriorQ := query({op:"Graph",root:"k",
  nodes:[{id:"k",entity:"device_kpi"},{id:"d",entity:"device"},{id:"t",entity:"tenant"}],
  edges:[{relation:"device_kpi_of_device",from:"k",to:"d"},{relation:"device_belongs_to_tenant",from:"d",to:"t"}],
  select:[{node:"t",dimension:"tenant_name"}],
  measures:[{node:"k",measure:"cpu_usage"},{node:"k",measure:"memory_usage"}],
  time_windows:[{node:"k",dimension:"device_kpi_utc_day",start:days[0].start.dateTimeUtc,end:days[6].end.dateTimeUtc}],
  limit:500});
data kpiRecentQ := query({op:"Graph",root:"k",
  nodes:[{id:"k",entity:"device_kpi"},{id:"d",entity:"device"},{id:"t",entity:"tenant"}],
  edges:[{relation:"device_kpi_of_device",from:"k",to:"d"},{relation:"device_belongs_to_tenant",from:"d",to:"t"}],
  select:[{node:"t",dimension:"tenant_name"}],
  measures:[{node:"k",measure:"cpu_usage"},{node:"k",measure:"memory_usage"}],
  time_windows:[{node:"k",dimension:"device_kpi_utc_day",start:days[7].start.dateTimeUtc,end:days[13].end.dateTimeUtc}],
  limit:500});

data kpiTenantCount := select_one({from:{x:kpiRecentQ},group_by:(r)=>({}),fields:(g,rows)=>({n:count(rows)})});

data top5Kpi := select({
  from:{t:top5},
  joins:[
    {kind:"left",source:{p:kpiPriorQ},on:(r)=>r.t.tenant == r.p.t_tenant_name},
    {kind:"left",source:{q:kpiRecentQ},on:(r)=>r.t.tenant == r.q.t_tenant_name}
  ],
  fields:(r)=>({tenant:r.t.tenant,
    cpuPrior:r.p?.k_cpu_usage,cpuRecent:r.q?.k_cpu_usage,
    memPrior:r.p?.k_memory_usage,memRecent:r.q?.k_memory_usage}),
  order_by:(o)=>[asc(o.tenant)]
});
data kpiCoveredCount := select_one({from:{x:top5Kpi},where:(r)=>is_some(r.x.cpuPrior) && is_some(r.x.cpuRecent),group_by:(r)=>({}),fields:(g,rows)=>({n:count(rows)})});

data kp1 := select({from:{x:top5Kpi},fields:(r)=>({tenant:r.x.tenant,metric:"CPU·前一周",value:r.x.cpuPrior})});
data kp2 := select({from:{x:top5Kpi},fields:(r)=>({tenant:r.x.tenant,metric:"CPU·最近一周",value:r.x.cpuRecent})});
data kp3 := select({from:{x:top5Kpi},fields:(r)=>({tenant:r.x.tenant,metric:"内存·前一周",value:r.x.memPrior})});
data kp4 := select({from:{x:top5Kpi},fields:(r)=>({tenant:r.x.tenant,metric:"内存·最近一周",value:r.x.memRecent})});
data kpiLong := union_all([kp1,kp2,kp3,kp4]);

// ---------- 5 个租户：最近一周级别构成与分类分布 ----------
data sevRecentQ := query({op:"Graph",root:"a",
  nodes:[{id:"a",entity:"current_alarm"},{id:"t",entity:"tenant"}],
  edges:[{relation:"alarm_belongs_to_tenant",from:"a",to:"t"}],
  select:[{node:"t",dimension:"tenant_name"},{node:"a",dimension:"alarm_severity"}],
  measures:[{node:"a",measure:"alarm_count"}],
  time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[7].start.epochMillis,end:days[13].end.epochMillis}],
  limit:500});
data catRecentQ := query({op:"Graph",root:"a",
  nodes:[{id:"a",entity:"current_alarm"},{id:"t",entity:"tenant"}],
  edges:[{relation:"alarm_belongs_to_tenant",from:"a",to:"t"}],
  select:[{node:"t",dimension:"tenant_name"},{node:"a",dimension:"current_alarm__MECATEGORY"}],
  measures:[{node:"a",measure:"alarm_count"}],
  time_windows:[{node:"a",dimension:"alarm_occur_utc_raw",start:days[7].start.epochMillis,end:days[13].end.epochMillis}],
  limit:500});

data sevRows := select({from:{x:sevRecentQ},
  fields:(r)=>({tenant:r.x.t_tenant_name,severity:r.x.a_alarm_severity ?? "unknown",n:r.x.a_alarm_count})});
data sevTop5 := select({from:{s:sevRows},
  joins:[{kind:"inner",source:{t:top5},on:(r)=>r.s.tenant == r.t.tenant}],
  fields:(r)=>({tenant:r.s.tenant,severity:r.s.severity,n:r.s.n})});

data catRows := select({from:{x:catRecentQ},
  fields:(r)=>({tenant:r.x.t_tenant_name,category:r.x.a_current_alarm__MECATEGORY,n:r.x.a_alarm_count})});
data catTop5 := select({from:{c:catRows},
  joins:[{kind:"inner",source:{t:top5},on:(r)=>r.c.tenant == r.t.tenant}],
  fields:(r)=>({tenant:r.c.tenant,category:r.c.category,n:r.c.n})});
data catKeep := select({from:{c:catTop5},group_by:(r)=>({category:r.c.category}),
  fields:(g,rows)=>({category:g.category,total:sum(rows.c.n) ?? 0}),
  order_by:(o)=>[desc(o.total),asc(o.category)],limit:8});
data catChartRows := select({from:{c:catTop5},
  joins:[{kind:"inner",source:{k:catKeep},on:(r)=>r.c.category == r.k.category}],
  fields:(r)=>({tenant:r.c.tenant,category:r.c.category,n:r.c.n})});

// ---------- 图表 ----------
data trendSpec := {x:"day",value:"n",xLabel:"日期",valueLabel:"告警数",title:"近 14 日每日告警量"};
figure trendChart := LineChart(spec = trendSpec, data = dailyTotal);

data growthSpec := {x:"tenant",value:"n",series:"week",stack:"total",valueLabel:"告警数",title:"告警增幅最大的 5 个租户：前一周与最近一周告警量"};
figure growthChart := ColumnChart(spec = growthSpec, data = growthLong);

data openSpec := {x:"tenant",value:"ratio",sort:"desc",unit:"%",valueLabel:"未清除占比（%）",title:"5 个租户最近一周未清除告警占比"};
figure openChart := BarChart(spec = openSpec, data = openRatio);

data kpiSpec := {x:"tenant",value:"value",series:"metric",valueLabel:"平均使用率（%）",title:"5 个租户前后两周 CPU / 内存平均使用率"};
figure kpiChart := ColumnChart(spec = kpiSpec, data = kpiLong);

data sevSpec := {x:"tenant",value:"n",series:"severity",stack:"total",valueLabel:"告警数",title:"5 个租户最近一周告警级别构成"};
figure sevChart := ColumnChart(spec = sevSpec, data = sevTop5);

data catSpec := {x:"category",series:"tenant",value:"n",title:"5 个租户最近一周告警分类分布（前 8 类）"};
figure catChart := Heatmap(spec = catSpec, data = catChartRows);

// ---------- 报告 ----------
report answer := Report(title = "近 14 天租户告警变化与设备资源对比") [
  h1 [ "近 14 个完整自然日：最近 7 天与前 7 天对比" ],
  p [ "统计口径：Asia/Shanghai 时区最近 14 个完整自然日；前一周为第 1–7 个自然日，最近一周为第 8–14 个自然日。告警量按告警发生时间归属，计数单位为告警事件条数；未清除占比 = 未清除告警条数 ÷ 同期告警条数。设备 CPU、内存为采样点平均使用率。" ],
  p [ "两周告警合计：前一周 ", Value(data = priorWeekTotal?.n), " 条，最近一周 ", Value(data = recentWeekTotal?.n), " 条。" ],
  p [ "告警量增幅排名仅纳入前一周告警量大于 0 且增幅为正的租户；前一周告警量为 0 的租户单独统计，共 ", Value(data = zeroBaseCount?.n), " 个，不参与增幅排名。" ],
  p [ "增幅最大的租户：", Value(data = growthTop?.tenant), "，前一周 ", Value(data = growthTop?.priorTotal), " 条，最近一周 ", Value(data = growthTop?.recentTotal), " 条，增加 ", Value(data = growthTop?.growth), " 条。" ],
  p [ "关联覆盖：最近一周有告警且可关联到租户视图的租户 ", Value(data = alarmTenantCount?.n), " 个；可关联到设备 KPI 的租户 ", Value(data = kpiTenantCount?.n), " 个；5 个租户中两周均有设备指标的是 ", Value(data = kpiCoveredCount?.n), " 个。未关联到租户的告警与未匹配到租户的设备样本不进入租户口径。" ],
  h2 [ "每日告警趋势" ],
  figure [ Figure(ref = trendChart), figcaption [ "近 14 日每日告警量" ] ],
  h2 [ "告警增幅最大的 5 个租户" ],
  figure [ Figure(ref = growthChart), figcaption [ "5 个租户前一周与最近一周告警量对比" ] ],
  figure [ Figure(ref = openChart), figcaption [ "5 个租户最近一周未清除告警占比" ] ],
  h2 [ "5 个租户前后两周设备资源" ],
  p [ "下图为同一批 5 个租户在两个 7 日区间内的设备 CPU、内存平均使用率，仅作同期对照，不用于推断告警与资源使用之间的因果关系。" ],
  figure [ Figure(ref = kpiChart), figcaption [ "5 个租户前后两周 CPU / 内存平均使用率" ] ],
  h2 [ "5 个租户最近一周告警构成" ],
  figure [ Figure(ref = sevChart), figcaption [ "最近一周告警级别构成" ] ],
  figure [ Figure(ref = catChart), figcaption [ "最近一周告警分类分布" ] ],
  h2 [ "口径与限制" ],
