data rows = query({limit:5});
data summary = select_one({from:{r:rows},fields:r=>({n:r.r.n}),limit:1});
answer tree! { Answer [
    if (is_some(summary)) [p ["present"]] else if (False) [] else [p ["empty"]],
    if let Some(i) = summary [
        p [Value(data=i.n)],
        if (i.n > 0) [strong ["positive"]],
    ] else [p ["empty"]],
    if let Some(i) = (rows[0]) [p [Value(data=i.n)]],
] };
